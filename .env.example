# ===== 生产环境变量模板 =====
# 复制此文件为 .env 并根据实际情况修改

# 是否开启调试模式 (生产环境必须设为 false)
DEBUG=false

# JWT 密钥 (生产环境必须修改为随机字符串, 用 openssl rand -hex 32 生成)
SECRET_KEY=change-me-to-a-random-secret-key

# 是否允许 dev token 万能认证 (生产环境必须设为 false)
ENABLE_DEV_TOKEN=false

# Uvicorn 配置
UVICORN_RELOAD=false
UVICORN_WORKERS=1

# 数据库类型: sqlite / mysql / postgres
DB_TYPE=sqlite

# MySQL/PostgreSQL 配置 (仅当 DB_TYPE 不为 sqlite 时需要)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=yourusername
# DB_PASSWORD=yourpassword
# DB_NAME=yourdatabase
